# Non-secret runtime defaults. Platform environment variables override these.
: "${FISHTANK_WORLD_ID:=village}"
: "${FISHTANK_EVENT_HISTORY_LIMIT:=2000}"
: "${FISHTANK_COMMAND_HISTORY_LIMIT:=1000}"
: "${FISHTANK_DATABASE_MAX_CONNECTIONS:=2}"
: "${FISHTANK_STREAM_KEEPALIVE_SECONDS:=60}"
: "${MALLOC_ARENA_MAX:=2}"
: "${MALLOC_TRIM_THRESHOLD_:=131072}"
: "${RUST_LOG:=fishtank_server=info,tower_http=warn}"

export FISHTANK_WORLD_ID
export FISHTANK_EVENT_HISTORY_LIMIT
export FISHTANK_COMMAND_HISTORY_LIMIT
export FISHTANK_DATABASE_MAX_CONNECTIONS
export FISHTANK_STREAM_KEEPALIVE_SECONDS
export MALLOC_ARENA_MAX
export MALLOC_TRIM_THRESHOLD_
export RUST_LOG
