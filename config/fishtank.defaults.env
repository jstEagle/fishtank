# Non-secret runtime defaults. Platform environment variables override these.
: "${FISHTANK_WORLD_ID:=village}"
: "${FISHTANK_EVENT_HISTORY_LIMIT:=2000}"
: "${FISHTANK_COMMAND_HISTORY_LIMIT:=1000}"
: "${RUST_LOG:=fishtank_server=info,tower_http=info}"

export FISHTANK_WORLD_ID
export FISHTANK_EVENT_HISTORY_LIMIT
export FISHTANK_COMMAND_HISTORY_LIMIT
export RUST_LOG
